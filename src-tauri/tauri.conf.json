{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Трекер Звичок",
  "version": "1.0.1",
  "identifier": "com.habits.tracker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Трекер Звичок",
        "width": 960,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 1000,
        "maxWidth": 960,
        "maxHeight": 1000,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:habits.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDRTRERDA5OEExQzYyQTIKUldTaVloeUtDZDNrelBxS25VTzVBQyt3cDlHWG5HSDFCZncvQzJKN2dNR1ZkMlpEakpHdCtlNmQK",
      "endpoints": [
        "https://github.com/MaxSkyi/DailyHabbits/releases/latest/download/latest.json"
      ]
    }
  }
}
